# =============================================================================
# BhumiDrishti — Docker Compose Environment Variables
# =============================================================================
# Copy this file to .env and fill in secure values before running docker-compose.
#
#   cp .env.example .env
#
# NEVER commit the .env file to version control. It is already in .gitignore.
# =============================================================================

# JWT Authentication Secrets (generate secure random strings, 32+ chars each)
JWT_SECRET=change_me_to_a_secure_random_string
JWT_REFRESH_SECRET=change_me_to_a_secure_random_string

# MinIO Object Storage Credentials
MINIO_ROOT_USER=change_me_minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_secret_key
