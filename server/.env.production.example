# Render Environment Variables (Set in Render Web Service Dashboard):
NODE_ENV=production
PORT=10000

# MongoDB Atlas Connection URI (Replace with your Atlas connection string):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/bhumidrishti?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate secure random strings):
JWT_SECRET=bhumidrishti_jwt_production_secret_key_change_me_sih2026
JWT_REFRESH_SECRET=bhumidrishti_jwt_refresh_production_secret_key_change_me_sih2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Upload Limit (MB):
MAX_FILE_SIZE_MB=25

# OCR Engine (tesseract | mock | cloud_vision):
OCR_PROVIDER=tesseract

# Confidence Thresholds:
CONFIDENCE_THRESHOLD_OVERALL=80
CONFIDENCE_THRESHOLD_FIELD=60

# Background Queue (set to false for in-memory async runner on Render free tier):
ENABLE_REDIS_QUEUE=false

# Logging Level:
LOG_LEVEL=info

# Frontend Origin Allowed for CORS (your Vercel app URL):
CORS_ORIGIN=https://bhumidrishti.vercel.app
